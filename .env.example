# Copy to .env.local and fill in real values. Never commit secrets.

# WebSocket URL (e.g. wss://example.com/websocket)
VITE_WS_URL=wss://gob01-ws.relaxwmestu.xyz/websocket

# Auth + routing (see docs/frontend-backend-websocket-guide.md)
VITE_AGENT_ID=1
VITE_ACCESS_TOKEN=1-valid-token-001
VITE_GAME_ROUTE=game-the-last-guardian-of-angkor

# Request timeout (ms) for spin wait
VITE_WS_TIMEOUT_MS=10000
