# Local be-wsproxy (Spring, port 9090, serves REST at root)
VITE_API_AUTH_URL=http://localhost:9090
# Auth refresh (same host as local be-wsproxy)
VITE_AUTH_REFRESH_URL=http://localhost:9090/api/auth/refresh
# Interval (ms) between auth refresh calls on an open WebSocket (default 115000)
VITE_AUTH_REFRESH_INTERVAL_MS=115000

# WebSocket endpoint
VITE_WS_URL=ws://localhost:9090/websocket

# Agent id for WS connect frame (default 1)
VITE_AGENT_ID=AGENCY_001

# Request timeout (ms) for spin wait
VITE_WS_TIMEOUT_MS=10000
