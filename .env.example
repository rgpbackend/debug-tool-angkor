# Default: local be-wsproxy. Copy to .env.local (gitignored) and restart Vite.
#
# Staging bug: comment the local block, uncomment the staging block, restart Vite.

# --- local ---
VITE_API_AUTH_URL=http://localhost:9090
VITE_AUTH_REFRESH_URL=http://localhost:9090/api/auth/refresh
VITE_AUTH_REFRESH_INTERVAL_MS=115000
VITE_WS_URL=ws://localhost:9090/websocket

# --- staging (agency001 + Luigi gob02) ---
# VITE_API_AUTH_URL=https://agency001.relaxwmestu.xyz/api/v1
# VITE_AUTH_REFRESH_URL=https://authentication.relaxwmestu.xyz/api/auth/refresh
# VITE_WS_URL=wss://gob02-ws.relaxwmestu.xyz/websocket

VITE_AGENT_ID=AGENCY_001
VITE_WS_TIMEOUT_MS=10000
