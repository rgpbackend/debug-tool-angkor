# Copy to .env.local and fill in real values. Never commit secrets.

# Agency REST API (login, play-game)
VITE_API_BASE_URL=https://agency001.relaxwmestu.xyz/api/v1

# WebSocket endpoint
VITE_WS_URL=wss://gob02-ws.relaxwmestu.xyz/websocket

# Game id for POST /play-game and WS join route
VITE_GAME_ID=game-the-last-guardian-of-angkor

# Agent id for WS connect frame (default 1)
VITE_AGENT_ID=AGENCY_001

# Request timeout (ms) for spin wait
VITE_WS_TIMEOUT_MS=10000

# Refresh token endpoint (reload → new WS access token)
VITE_AUTH_REFRESH_URL=https://authentication.relaxwmestu.xyz/api/auth/refresh
